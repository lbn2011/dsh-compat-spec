{
  "_comment": "Expected outcomes for the sibling .json declaration files in this directory. Each file is a bare declaration (no wrapper). For negative vectors the {code,path} pairs listed must be produced EXACTLY (order-insensitive; extra or missing issues fail). For positive vectors the declaration must validate with zero issues. structural/ lists raw JSON texts evaluated after JSON.parse.",
  "protocolVersion": "0.1.0-draft.1",
  "positive": {
    "01-minimal-tool.json": {
      "name": "minimal-tool",
      "doc": "Smallest accepted declaration: empty capability lists and an explicit empty resources array."
    },
    "02-with-capabilities-and-resources.json": {
      "name": "capabilities-and-resources",
      "doc": "Non-empty capability lists plus one tool and one service claim; version deliberately uses a pre-release/build spelling that this protocol does not parse."
    },
    "03-free-form-scope-labels.json": {
      "name": "free-form-scope-labels",
      "doc": "scope is any static label without leading or trailing whitespace: 'plugin', 'agent' and 'per-session' are equally opaque to this protocol."
    },
    "04-same-name-different-kind-or-scope.json": {
      "name": "same-name-different-kind-or-scope",
      "doc": "Duplicate detection is by (kind,name,scope); sharing a name across kinds or scopes is allowed."
    },
    "05-unicode-and-punctuation-names.json": {
      "name": "unicode-and-punctuation-names",
      "doc": "Identifiers are opaque non-empty strings; no character class is imposed beyond the whitespace/control rules."
    },
    "06-empty-parts-with-empty-lists.json": {
      "name": "empty-parts-with-empty-lists",
      "doc": "Single-character identifiers and explicit empty arrays are accepted."
    }
  },
