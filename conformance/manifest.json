  "structural": {
    "01-duplicate-schema-version.json.txt": {
      "name": "01-duplicate-schema-version",
      "doc": "JSON.parse keeps the last duplicate; the duplicate key itself is invisible to JavaScript. A JSON-text parser should report DUPLICATE_FIELD on the repeated key.",
      "issues": [
        {
          "code": "DUPLICATE_FIELD",
          "path": "schemaVersion"
        }
      ],
      "evaluatedAs": "JSON.parse of the file text; a value-level validator cannot detect duplicate keys, so this vector is only decidable by a JSON-text-aware parser"
    },
    "02-duplicate-required.json.txt": {
      "name": "02-duplicate-required",
      "doc": "Duplicate required[] field name. Only the last value survives JSON.parse.",
      "issues": [
        {
          "code": "DUPLICATE_FIELD",
          "path": "capabilities.required"
        }
      ],
      "evaluatedAs": "JSON.parse of the file text; a value-level validator cannot detect duplicate keys, so this vector is only decidable by a JSON-text-aware parser"
    },
    "03-duplicate-plugin-id.json.txt": {
      "name": "03-duplicate-plugin-id",
      "doc": "The surviving plugin.id is valid, so a value-level check passes; only a text-level duplicate detector can reject this.",
      "issues": [
        {
          "code": "DUPLICATE_FIELD",
          "path": "plugin.id"
        }
      ],
      "evaluatedAs": "JSON.parse of the file text; a value-level validator cannot detect duplicate keys, so this vector is only decidable by a JSON-text-aware parser"
    },
    "04-duplicate-resource-name.json.txt": {
      "name": "04-duplicate-resource-name",
      "doc": "Duplicate field name inside a resources[] entry.",
      "issues": [
        {
          "code": "DUPLICATE_FIELD",
          "path": "resources[0].name"
        }
      ],
      "evaluatedAs": "JSON.parse of the file text; a value-level validator cannot detect duplicate keys, so this vector is only decidable by a JSON-text-aware parser"
    }
